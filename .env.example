NODE_ENV=development
PORT=4000
LOG_LEVEL=info
DATABASE_URL=postgresql://securewatch:securewatch@localhost:5432/securewatch?schema=public
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ENCRYPTION_KEY=replace-with-a-32-byte-base64-or-hex-key
FRONTEND_URL=http://localhost:3000
API_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000
THREAT_PROVIDER=demo
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
EVENT_RETENTION_DAYS=90
AUDIT_RETENTION_DAYS=365
COOKIE_SECURE=false
# Keep demo-only verification/reset tokens disabled outside local development.
DEMO_MODE=true
